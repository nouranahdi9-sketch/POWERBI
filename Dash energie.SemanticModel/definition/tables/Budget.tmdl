	measure Evolution_Elec_vs_Budget = ```
			
			VAR Moyenne_Conso_Elec = AVERAGE('Main Table'[elec_kwh_ton_R2])
			VAR Moyenne_Budget_Elec = AVERAGE(Budget[Electricité])
			VAR Ecart_Reel = Moyenne_Conso_Elec - Moyenne_Budget_Elec
			VAR Taux_Evolution = DIVIDE(Ecart_Reel, Moyenne_Budget_Elec, 0)
			RETURN 
			    "vs budget " & FORMAT(Ecart_Reel, "0.0") & "   (" & FORMAT(Taux_Evolution, "0.0%)")
			     
			
			
			```
		lineageTag: 96a87023-9b26-4436-8e97-7bed2e7308ae

