	measure Diff_gas = [Seuil_Top15_Gaz] -[Moyenne_courbe_gauss_gas]
		lineageTag: 05965d26-b71c-4dad-a6ab-8412e8990ee8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Diff_elec = [Seuil_Top15_elec] -[Moyenne_courbe_gauss_elec]
		lineageTag: 12dee28b-9bd7-4d47-ae8d-91de790b4747

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NORMAL DISTRIBUTION gas bis' =
			
			var minvalue=Floor([x-30_gas],1)
			var maxvalue=Floor([x+30_gas],1)
			return
			SELECTCOLUMNS(CALENDAR(minvalue,maxvalue),"X_gas",int([Date]))
		formatString: 0
		lineageTag: 1fd06081-005c-480a-a596-c7d1f9a6be3c

	measure f(x)_gas_bis = ```
			
			EXP(
			    ( [NORMAL DISTRIBUTION gas bis] - [Moyenne_courbe_gauss_gas] )^2 / 
			    (2 * [Ecart_Type_courbe_gauss_gas]^2) * -1
			) /
			SQRT(2 * PI() * [Ecart_Type_courbe_gauss_gas])
			
			
			```
		lineageTag: d2f800b0-3a22-4a2c-b505-e60fa14fe995

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Courbe_Gauss_Gas = ```
			
			VAR X_gas = SELECTEDVALUE('NORMAL DISTRIBUTION gas'[X_gas])
			RETURN
			    IF(
			        X_gas >= [x-30_gas] && X_gas <= [x+30_gas],
			        EXP(
			            ((X_gas - [Moyenne_courbe_gauss_gas])^2) / 
			            (2 * ([Ecart_Type_courbe_gauss_gas]^2)) * -1
			        ) / SQRT(2 * PI() * [Ecart_Type_courbe_gauss_gas]),
			        BLANK()
			    )
			
			```
		lineageTag: 4a5cf929-7fda-48dc-9e9c-7e0a12b364a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure gauss_gas_main_table =
			
			var X = SELECTEDVALUE('NORMAL DISTRIBUTION gas'[X_gas])
			return NORM.DIST(X, [Moyenne_courbe_gauss_gas], [Ecart_Type_courbe_gauss_gas], FALSE())
		lineageTag: b4e53f76-7f98-46ce-8b5b-5c0a43f380b2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure gauss_elec_main_table =
			
			var X = SELECTEDVALUE('NORMAL DISTRIBUTION elec'[X_elec])
			return NORM.DIST(X, [Moyenne_courbe_gauss_elec], [Ecart_Type_courbe_gauss_elec], FALSE())
		lineageTag: 346a6e02-af81-4cb5-8b42-de38d552ff3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

