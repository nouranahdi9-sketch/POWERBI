	measure Baseline_avg_Thermal_total_ByMonth =
			
			CALCULATE(
			    AVERAGE('Main table'[total_thermique]),
			    REMOVEFILTERS('Main table'[batch_number]),
			    VALUES('Calendrier'[kiln_unload_end_date_Month_fr]),
			    VALUES('Calendrier'[kiln_unload_end_date_Year])
			)
		lineageTag: a34ec986-3a1f-4ca9-9368-24019274af2b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Baseline_avg_Elec_total_ByMonth = ```
			
