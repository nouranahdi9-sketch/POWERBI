	measure Evolution_Ventil_vs_Min_Year = ```
			
			VAR Moyenne_Conso_Ventil = AVERAGE('Main Table'[conso_ventil_kwh_1]) 
			VAR Top15_Conso_Ventil_Year = 
			    AVERAGEX(
			        TOPN(
			            15,
			            CALCULATETABLE(
			                'Main Table',
			                ALL('Main Table'),
			                VALUES('Calendrier'[kiln_unload_end_date_Year]) -- Filtrage sur l'année
			            ),
			            'Main Table'[conso_ventil_kwh_1], ASC
			        ),
			        'Main Table'[conso_ventil_kwh_1]
			    )
			VAR Ecart_Reel = Moyenne_Conso_Ventil - Top15_Conso_Ventil_Year
			VAR Taux_Evolution = DIVIDE(Ecart_Reel, Top15_Conso_Ventil_Year, 0)
			RETURN 
			    "vs top 15 perf. " & FORMAT(Ecart_Reel, "0.0") & "   (" & FORMAT(Taux_Evolution, "0.0%)") 
			    
			
			```
		lineageTag: 447abd4f-093f-4878-ab5d-e5f687c127fe

