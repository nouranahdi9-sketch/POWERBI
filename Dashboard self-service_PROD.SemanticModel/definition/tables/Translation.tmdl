table Translation
	lineageTag: 521440a1-73b0-4952-9316-915096f19b3d

	measure 'Title Measurement by batch' =
			
			VAR CurrentCulture = USERCULTURE()
			
			VAR TitleTranslated =
			    CALCULATE (
			        SELECTEDVALUE ( Translation[TranslationText] ),
			        Translation[ReportCode] = "SelfService",
			        Translation[TranslationKey] = "TITLE_MEASUREMENTS",
			        Translation[LanguageCode] = CurrentCulture
			    )
			
			VAR TitleDefault =
			    CALCULATE (
			        SELECTEDVALUE ( Translation[TranslationText] ),
			        Translation[ReportCode] = "SelfService",
			        Translation[TranslationKey] = "TITLE_MEASUREMENTS",
			        Translation[LanguageCode] = "en-US"
			    )
			
			RETURN
			COALESCE ( TitleTranslated, TitleDefault )
		lineageTag: 4358cb4e-7f9b-4bad-b244-213bd10c1c99

