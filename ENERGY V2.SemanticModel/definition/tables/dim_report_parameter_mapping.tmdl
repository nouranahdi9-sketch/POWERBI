table dim_report_parameter_mapping
	lineageTag: c2ca9ffa-e511-42a4-bd7f-a8c519f0d4b2

	measure Valeur =
			
			VAR ParamCourant =
			    SELECTEDVALUE(fact_batch_measures[parameter_id])
			
			VAR TypeAgg =
			    LOOKUPVALUE(
			        'dim_report_parameter_mapping'[aggregation],
			        'dim_report_parameter_mapping'[parameter_id], ParamCourant
			    )
			
			VAR ExclureZero =
			    LOOKUPVALUE(
			        'dim_report_parameter_mapping'[exclure_zero_moyenne],
			        'dim_report_parameter_mapping'[parameter_id], ParamCourant
			    )
			
			VAR ValeurSomme =
			    CALCULATE(
			        SUM(fact_batch_measures[value])
			    )
			
			VAR ValeurMoyenneFiltree =
			    CALCULATE(
			        AVERAGE(fact_batch_measures[value]),
			        fact_batch_measures[value] <> 0
			    )
			
			VAR ValeurMoyenne =
			    IF(
			        ExclureZero = TRUE,
			        IF(ISBLANK(ValeurMoyenneFiltree), 0, ValeurMoyenneFiltree),
			        CALCULATE(AVERAGE(fact_batch_measures[value]))
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        TypeAgg = "Somme", ValeurSomme,
			        ValeurMoyenne
			    )
		lineageTag: 0c2cf105-f88c-4099-971c-4506bbd01c8b

		formatStringDefinition =
				IF(
				    LOOKUPVALUE(
				        'dim_report_parameter_mapping'[aggregation],
				        'dim_report_parameter_mapping'[parameter_id], SELECTEDVALUE(fact_batch_measures[parameter_id])
				    ) = "Somme",
				    "0",
				    "0.00"
				)

	column parameter_id
		dataType: int64
		formatString: 0
		lineageTag: f37390be-64b3-461e-b267-e35216dce100
		summarizeBy: none
		sourceColumn: parameter_id
		sortByColumn: display_order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

