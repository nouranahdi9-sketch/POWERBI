				column error_messages
					caption: Error message
				column cycle_label
					caption: Production cycle duration
			table fact_process_time_analyses
				column mesure_name
					caption: Measure
				column categorie
					caption: Category
				column measure_type
					caption: Type
				column sequence
					caption: Sequence
				column label
					caption: Label
				column measure_description
					caption: Description
				column columns_source
					caption: Source variables
				column date_debut
					caption: Start Date
				column date_fin
					caption: End Date
				column measure_value_hhmm
					caption: Duration
				column seuiltop20_value_hhmm
					caption: Statistical Target
				column deltatop20_value_hhmm
					caption: Statistical Delta
				column mesure_name_color
					caption: Measure
				column mesure_value_h
					caption: Cycle duration
				column top20_80th_percentile_h
					caption: Target (BI)
				column week_mesure
					caption: Week
				column year_mesure
					caption: Year
				column month_name_mesure
					caption: Month
				column flg_outlier
					caption: Outlier
				column target_business
					caption: Busines Targets
				column delta_target_business
					caption: Business Delta
				column delta_target_business_h
					caption: Business Delta
				column target_business_h
					caption: Busines Targets
				column batch_prd_cell
					caption: Prod. Cell
				column Date_fin_type_date
					caption: Production end date
				column label_graphe_cycle_time
					caption: Cycle time
				column label_graphe_transfer_time
					caption: Transfer time
				column label_graphe_waiting_time
					caption: Waiting time
				column mesure_value_transfer_graphe
					caption: Transfer duration
				column mesure_value_waiting_graphe
					caption: Waiting duration
				column date_fin_tab_overwiew
					caption: Measure end date
				column columns_source_metadate
					caption: Source localizations
				column measure_type_matadata
					caption: Type
				column 'label - CyTiWai'
					caption: Measure
				column targetbusiness_value_hhmm
					caption: Busines Targets
				column delta_targetbusiness_value_hhmm
					caption: Business Delta
			table dim_site
				column plant
					caption: Production line
			table fact_batch_note
				column date_saisie
					caption: Date
				column note
					caption: Note.
				column location
					caption: Location.
				column event
					caption: Event.
				column impact
					caption: Impact.
				column detail
					caption: Detail.
				column gap_minutes
					caption: Gap (min)
				column Gap_Heures
					caption: Total time lost (h)
				column full_name
					caption: Author
			table Periode
				column Label
					caption: Last hours
			table Calcul
				measure BatchNumber_MaxMesureValue
					caption: Batch of max duration
				measure BatchNumber_MinMesureValue
					caption: Batch of min duration
				measure 'Moyenne hh:mm'
					caption: avg. Duration
				measure Moyenne_delta_target_business_hh:mm
					caption: Average Business Delta
				measure Moyenne_delta_top_20_hh:mm
					caption: avg. Delta (BI)
				measure Moyenne_target_business_hh:mm
					caption: Average Business Target
				measure Moyenne_top_20_hh:mm
					caption: avg. Target (BI)
				measure 'Max hh:mm'
					caption: Max
				measure 'Min hh:mm'
					caption: Min
				measure 'Batch-cycle Moyenne hh:mm'
					caption: Average

