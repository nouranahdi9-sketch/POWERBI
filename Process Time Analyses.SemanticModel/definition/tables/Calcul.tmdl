	measure Seuil_avg_week_Top20_30j = ```
			
			VAR _currentWeek =
			    SELECTEDVALUE('dim_batches_specifications'[week])
			
			VAR _endDate =
			    CALCULATE(
			        MAX('dim_batches_specifications'[date_fin_prod]),
			        'dim_batches_specifications'[week] = _currentWeek
			    )
			
			VAR _prdLines =
			    VALUES('dim_site'[plant])
			
			VAR _weightGroups =
			    VALUES('dim_batches_specifications'[goods_weight_group])
			
			VAR _batchIds_30j =
			    CALCULATETABLE(
			        VALUES('dim_batches_specifications'[batch_id]),
			        ALL('dim_batches_specifications'),
			        'dim_site'[plant] IN _prdLines,
			        'dim_batches_specifications'[goods_weight_group] IN _weightGroups,
			        'dim_batches_specifications'[date_fin_prod] <= _endDate,
			        'dim_batches_specifications'[date_fin_prod] >  _endDate - 30
			    )
			
			RETURN
			CALCULATE(
			    AVERAGE('fact_process_time_analyses'[top20_80th_percentile_h]),
			    KEEPFILTERS(TREATAS(_batchIds_30j, 'fact_process_time_analyses'[batch_id]))
			)
			
			```
		displayFolder: Mesures\AUTRES
		lineageTag: 7ad7e28b-c455-4b5f-97c1-4ca19f0ee8d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

