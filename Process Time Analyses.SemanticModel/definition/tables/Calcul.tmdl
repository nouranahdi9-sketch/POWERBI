	measure 'Evolution hh:mm' = ```
			
			VAR AvgMesure = AVERAGE('fact_process_time_analyses'[mesure_value])
			VAR AvgTonnage = AVERAGE('fact_process_time_analyses'[top20_80th_percentile_tonnage])
			VAR EvolutionPct = DIVIDE(AvgMesure - AvgTonnage, AvgTonnage, 0) * 100
			VAR TotalMinutes = EvolutionPct
			VAR AbsMinutes = ABS(TotalMinutes)
			VAR Hours = QUOTIENT(AbsMinutes, 60)
			VAR Minutes = INT(AbsMinutes) - Hours * 60
			VAR TimeFormat = FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00")
			VAR Arrow = 
			    IF(TotalMinutes > 0, "🔺 ",
			        IF(TotalMinutes < 0, "🔽 ", "")
			    )
			RETURN
			    IF(
			        ISBLANK(TotalMinutes),
			        BLANK(),
			        IF(TotalMinutes < 0,
			            Arrow & "-" & TimeFormat,
			            Arrow & TimeFormat
			        )
			    )
			
			```
		displayFolder: Mesures\AUTRES
		lineageTag: 9486e6f5-6028-4eb1-8a6b-7e53698d0e8b

	measure Evolution_24h_vs_48h_val_pastille = ```
			
			VAR Avg24h = [Avg_Last_24h]
			VAR Avg48h = [Avg_Last_48h]
			VAR Diff = Avg24h - Avg48h
			VAR IsNegative = Diff < 0
			VAR AbsMinutes = ABS(Diff)
			VAR Hours = QUOTIENT(AbsMinutes, 60)
			VAR Minutes = INT(AbsMinutes) - Hours * 60
			VAR FormattedTime = FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00")
			VAR Pastille = 
			    IF(
			        Diff <= 0,
			        "🟢",  -- amélioration ou stable
			        "🔴"   -- détérioration
			    )
			RETURN
			Pastille & " " & IF(IsNegative, "-" & FormattedTime, FormattedTime)
			
			```
		displayFolder: Mesures\AUTRES
		lineageTag: 4bb62733-4f45-468f-923e-53218d654453

