table Calcul
	lineageTag: 6ba5230c-f86d-4cfd-97d6-87998ee15631

	measure BatchNumber_MaxMesureValue = ```
			
			VAR MinValue =
			    MAXX(
			        VALUES('fact_process_time_analyses'[batch_id]),
			        CALCULATE(MAX('fact_process_time_analyses'[mesure_value]))
			    )
			VAR BatchID =
			    MAXX(
			        FILTER(
			            VALUES('fact_process_time_analyses'),
			            'fact_process_time_analyses'[mesure_value] = MinValue
			        ),
			        'fact_process_time_analyses'[batch_id]
			    )
			RETURN
			    LOOKUPVALUE(
			        'dim_batches_specifications'[batch_number],
			        'dim_batches_specifications'[batch_id], BatchID
			    )
			
			```
		displayFolder: Mesures\AUTRES
		lineageTag: 28466a0a-c6cb-4c91-a493-c18815016c2b

	measure BatchNumber_MinMesureValue = ```
			
			VAR MinValue =
			    MINX(
			        VALUES('fact_process_time_analyses'[batch_id]),
			        CALCULATE(MIN('fact_process_time_analyses'[mesure_value]))
			    )
			VAR BatchID =
			    MINX(
			        FILTER(
			            VALUES('fact_process_time_analyses'),
			            'fact_process_time_analyses'[mesure_value] = MinValue
			        ),
			        'fact_process_time_analyses'[batch_id]
			    )
			RETURN
			    LOOKUPVALUE(
			        'dim_batches_specifications'[batch_number],
			        'dim_batches_specifications'[batch_id], BatchID
			    )
			
			```
		displayFolder: Mesures\AUTRES
		lineageTag: 150360e2-6e56-4c42-adab-b2c093f16ceb

	measure 'Moyenne hh:mm' =
			
			VAR TotalMinutes = AVERAGE('fact_process_time_analyses'[mesure_value])
			VAR IsNegative = TotalMinutes < 0
			VAR AbsMinutes = ABS(TotalMinutes)
			VAR Hours = QUOTIENT(AbsMinutes, 60)
			VAR Minutes = INT(AbsMinutes) - Hours * 60
			VAR Result = FORMAT(Hours, "00") & ":" & FORMAT(Minutes, "00")
			RETURN
			IF(
			    ISBLANK(TotalMinutes),
			    BLANK(),
			    IF(IsNegative, "-" & Result, Result)
			)
		displayFolder: Mesures\AUTRES
		lineageTag: 66c5cf29-110a-41d7-b553-93d521c07ed7

