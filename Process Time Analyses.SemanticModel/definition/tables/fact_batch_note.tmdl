	column Last72h_notes_prd = ```
			
			VAR NowFrance = MAX('dim_batches_specifications'[HeureFranceDynamique])
			RETURN
			IF(
			    'fact_batch_note'[date_saisie] >= NowFrance - 3
			        && 'fact_batch_note'[date_saisie] <= NowFrance,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: ce5b34ed-b05c-4ddb-9633-5c0f67e32fc5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

