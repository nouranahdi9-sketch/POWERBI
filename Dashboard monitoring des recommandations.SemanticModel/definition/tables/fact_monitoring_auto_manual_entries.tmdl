table fact_monitoring_auto_manual_entries
	lineageTag: 821a9180-1ad3-41f5-9ba8-17f004e50b54

	measure Evolution_succes = ```
			
			VAR reco_succes = SUM('fact_monitoring_auto_manual_entries'[flg_succes])
			VAR reco_total =  SUM('fact_monitoring_auto_manual_entries'[flg_echec]) +  SUM('fact_monitoring_auto_manual_entries'[flg_succes])
			VAR Taux_recos_succes = DIVIDE(reco_succes, reco_total, 0)
			RETURN 
			    FORMAT(reco_succes, "0") & "   (" & FORMAT(Taux_recos_succes, "0%)")
			```
		lineageTag: 979c0055-c2e3-49ea-b38c-e666aee5baa9

	measure Evolution_echec_manual = ```
			
			VAR reco_echec = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        'fact_monitoring_auto_manual_entries'[has_manual_value] = 1 ,
			        'fact_monitoring_auto_manual_entries'[has_auto_value] = 0
			    )
			VAR reco_total = 
			    SUMX(
			        'fact_monitoring_auto_manual_entries',
			        'fact_monitoring_auto_manual_entries'[flg_echec] + 'fact_monitoring_auto_manual_entries'[flg_succes]
			    )
			
			VAR Taux_recos_echec = DIVIDE(reco_echec, reco_total, 0)
			RETURN 
			    FORMAT(reco_echec, "0") & "   (" & FORMAT(Taux_recos_echec, "0%") & ")"
			
			```
		lineageTag: a65e2fb8-2fb7-4cff-9571-8c49bc33bff2

	measure Evolution_echec_auto = ```
			
			VAR reco_echec = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        'fact_monitoring_auto_manual_entries'[has_auto_value] = 1, 'fact_monitoring_auto_manual_entries'[has_manual_value] = 0
			    )
			VAR reco_total = 
			    SUMX(
			        'fact_monitoring_auto_manual_entries',
			        'fact_monitoring_auto_manual_entries'[flg_echec] + 'fact_monitoring_auto_manual_entries'[flg_succes]
			    )
			
			VAR Taux_recos_echec = DIVIDE(reco_echec, reco_total, 0)
			RETURN 
			   FORMAT(reco_echec, "0") & "   (" & FORMAT(Taux_recos_echec, "0%") & ")"
			
			```
		lineageTag: 2fbae546-4a0a-43d3-94ff-aa7abfb993b2

	measure Evolution_echec_manual_auto = ```
			
			-- Calcul pour les recommandations manuelles et automatiques (flg_manual = 1 ET flg_auto = 1)
			VAR reco_echec_manual_auto = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        'fact_monitoring_auto_manual_entries'[has_manual_value] = 1 &&
			        'fact_monitoring_auto_manual_entries'[has_auto_value] = 1
			    )
			
			-- Calcul pour le total des flg_non_null
			VAR reco_total = 
			    SUMX(
			        'fact_monitoring_auto_manual_entries',
			        'fact_monitoring_auto_manual_entries'[flg_echec] + 'fact_monitoring_auto_manual_entries'[flg_succes]
			    )
			
			
			-- Taux d'échec pour les recommandations manuelles et automatiques
			VAR Taux_recos_echec_manual_auto = 
			    DIVIDE(reco_echec_manual_auto, reco_total, 0)
			
			-- Retour du résultat
			RETURN 
			    FORMAT(reco_echec_manual_auto, "0") & " (" & FORMAT(Taux_recos_echec_manual_auto, "0%") & ")"
			
			
			```
		lineageTag: ae766a35-8e8a-4025-9c42-cf31c60a3840

	measure Evolution_echec_process = ```
			
			VAR reco_echec = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        'fact_monitoring_auto_manual_entries'[has_auto_value] = 0, 'fact_monitoring_auto_manual_entries'[has_manual_value] = 0
			    )
			VAR reco_total = 
			    SUMX(
			        'fact_monitoring_auto_manual_entries',
			        'fact_monitoring_auto_manual_entries'[flg_echec] + 'fact_monitoring_auto_manual_entries'[flg_succes]
			    )
			
			VAR Taux_recos_echec = DIVIDE(reco_echec, reco_total, 0)
			RETURN 
			   FORMAT(reco_echec, "0") & "   (" & FORMAT(Taux_recos_echec, "0%") & ")"
			
			```
		lineageTag: 586784f5-37e2-4eaf-83bf-d07b2cf01b7c

	measure Evolution_echec_30j = ```
			
			VAR DerniereDate = today()
			VAR MoisEnCours_Debut = DerniereDate - 29 -- Début des 30 derniers jours
			VAR MoisPrecedente_Debut = DerniereDate - 60 -- Début du mois précédent
			VAR MoisPrecedente_Fin = DerniereDate - 30 -- Fin du mois précédent
			
			-- Total des flg_non_null pour le mois en cours
			VAR flg_nn_null_mois_en_cours = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        FILTER(
			            'fact_monitoring_auto_manual_entries', 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] >= MoisEnCours_Debut && 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] <= DerniereDate 
			        )
			    )
			
			-- Total des flg_non_null pour le mois précédent
			VAR flg_nn_null_mois_precedente = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        FILTER(
			            'fact_monitoring_auto_manual_entries', 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] >= MoisPrecedente_Debut && 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] < MoisPrecedente_Fin 
			        )
			    )
			
			-- Calcul de la différence et du taux d'évolution
			VAR Diff_flg_non_null = flg_nn_null_mois_en_cours - flg_nn_null_mois_precedente
			VAR Taux_evolution = DIVIDE(Diff_flg_non_null, flg_nn_null_mois_precedente, 0)
			
			-- Ajout d'un "+" si la différence est positive
			VAR Diff_flg_non_null_formate = 
			    IF(Diff_flg_non_null > 0, "+" & FORMAT(Diff_flg_non_null, "0"), FORMAT(Diff_flg_non_null, "0"))
			
			-- Déterminer la pastille (rouge pour négatif, vert pour positif ou zéro)
			VAR Pastille = 
			    IF(Diff_flg_non_null <= 0, "🟢", "🔵")
			
			-- Vérification si les données sont disponibles
			RETURN 
			    IF(
			        ISBLANK(flg_nn_null_mois_en_cours) || ISBLANK(flg_nn_null_mois_precedente),
			        "No data",
			        "vs previous period (" & Diff_flg_non_null_formate & ") " & Pastille
			    )
			
			```
		lineageTag: e65c95ed-4aea-40dd-b5d8-9d88af5ae543

	measure Evolution_echec_7j = ```
			
			VAR DerniereDate = today()
			VAR SemaineEnCours_Debut = DerniereDate - 6 -- Début des 7 derniers jours
			VAR SemainePrecedente_Debut = DerniereDate - 13 -- Début de la semaine précédente
			VAR SemainePrecedente_Fin = DerniereDate - 7 -- Fin de la semaine précédente
			
			-- Total des flg_null pour la semaine en cours
			VAR flg_nn_null_semaine_en_cours = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        FILTER(
			            'fact_monitoring_auto_manual_entries', 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] >= SemaineEnCours_Debut && 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] < DerniereDate  
			        )
			    )
			VAR flg_nn_null_semaine_precedente = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        FILTER(
			            'fact_monitoring_auto_manual_entries', 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] >= SemainePrecedente_Debut && 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] < SemainePrecedente_Fin 
			        )
			    )
			
			-- Calcul de la différence et du taux d'évolution
			VAR Diff_flg_non_null = flg_nn_null_semaine_en_cours - flg_nn_null_semaine_precedente
			VAR Taux_evolution = DIVIDE(Diff_flg_non_null, flg_nn_null_semaine_precedente, 0)
			
			-- Ajout d'un "+" si la différence est positive
			VAR Diff_flg_non_null_formate = 
			    IF(Diff_flg_non_null > 0, "+" & FORMAT(Diff_flg_non_null, "0"), FORMAT(Diff_flg_non_null, "0"))
			
			-- Déterminer la pastille (rouge pour négatif, vert pour positif ou zéro)
			VAR Pastille = 
			    IF(Diff_flg_non_null <= 0, "🟢" , "🔵")
			
			-- Retour du texte final avec la pastille
			RETURN 
			   "vs previous period (" & FORMAT(Diff_flg_non_null_formate, "0") & ") "  & Pastille
			```
		lineageTag: 1406a8a3-602d-475b-a808-7133bf7df6a1

	measure Evolution_echec_24h = ```
			
			VAR Hier = today()  -1
			VAR AvantHier = Hier - 2
			
			-- Calcul des totaux pour hier et avant-hier avec filtres supplémentaires
			VAR flg_non_null_hier = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        FILTER(
			            'fact_monitoring_auto_manual_entries', 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] >= Hier && 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] < TODAY() 
			        )
			    )
			VAR flg_non_null_avant_hier = 
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        FILTER(
			            'fact_monitoring_auto_manual_entries', 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] >= AvantHier && 
			            'fact_monitoring_auto_manual_entries'[calculation_interval_after_datetime] < Hier 
			        )
			    )
			
			-- Calcul de la différence et du taux d'évolution
			VAR Diff_flg_non_null = flg_non_null_hier
			VAR Taux_evolution = DIVIDE(Diff_flg_non_null, flg_non_null_avant_hier, 0)
			
			-- Ajout d'un "+" si la différence est positive
			VAR Diff_flg_non_null_formate = 
			    IF(Diff_flg_non_null > 0, "+" & FORMAT(Diff_flg_non_null, "0"), FORMAT(Diff_flg_non_null, "0"))
			
			-- Déterminer la pastille (rouge pour négatif, vert pour positif ou zéro)
			VAR Pastille = 
			    IF(Diff_flg_non_null <= 0, "🟢" , "🔵")
			
			-- Retour du texte final avec la pastille
			RETURN 
			   "vs previous period (" & FORMAT(Diff_flg_non_null_formate, "0") & ") "  & Pastille
			
			
			```
		lineageTag: 0d4dd573-f977-4ab5-adc9-65d402bf1167

	measure recos_attendues =
			
			SUM ( fact_monitoring_auto_manual_entries[flg_echec] )
			+ SUM ( fact_monitoring_auto_manual_entries[flg_succes] )
		formatString: 0
