	column Target_Localisation_Colors = ```
			
			VAR EchecMax =
			    CALCULATE(
			        MAX('fact_monitoring_auto_manual_entries'[flg_echec]),
			        ALLEXCEPT(
			            'fact_monitoring_auto_manual_entries',
			            'fact_monitoring_auto_manual_entries'[batch_id],
			            'fact_monitoring_auto_manual_entries'[id_parameter_localization]
			        )
			    )
			VAR TargetLoc = RELATED('dim_target_localization'[code])
			RETURN
			TargetLoc & IF(EchecMax = 1, " (🔵)", " (🟢)")
			
			```
