	column Missing_Values_Concat_auto = ```
			
			CONCATENATEX(
			    FILTER(
			        'fact_monitoring_auto_manual_entries',  -- Remplacez 'export (61)' par le nom de votre table
			        'fact_monitoring_auto_manual_entries'[id_production_line] = EARLIER('fact_monitoring_auto_manual_entries'[id_production_line]) && 
			        'fact_monitoring_auto_manual_entries'[batch_id] = EARLIER('fact_monitoring_auto_manual_entries'[batch_id]) &&
			        'fact_monitoring_auto_manual_entries'[id_parameter_localization] = EARLIER('fact_monitoring_auto_manual_entries'[id_parameter_localization]) &&
			        'fact_monitoring_auto_manual_entries'[flg_auto] = 1
			    ),
			    'fact_monitoring_auto_manual_entries'[missing_value],  -- La colonne à concaténer
			    ", ",  -- Séparateur entre les valeurs concaténées
			    'fact_monitoring_auto_manual_entries'[missing_value],  -- Si vous avez besoin de trier les valeurs avant concaténation (facultatif)
			    ASC  -- Trier par ordre croissant des valeurs
			)
			
			```
		lineageTag: 06ece6f2-42c6-454d-9190-552f2eda3cca
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

