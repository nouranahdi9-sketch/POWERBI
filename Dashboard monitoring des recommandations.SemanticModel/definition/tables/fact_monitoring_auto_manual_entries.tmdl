	measure Evolution_echec_tag_drop =
			
			VAR reco_echec =
			    CALCULATE(
			        SUM('fact_monitoring_auto_manual_entries'[flg_echec]),
			        (
			            ISBLANK('fact_ascendance_localization'[map_hour_occurrences])
			            || 'fact_ascendance_localization'[map_hour_occurrences] = "[]"
			        )
			    )
			RETURN
			    FORMAT(reco_echec, "0")
		lineageTag: dbc66a47-16c7-4988-bd94-d0d0875f6d7c

