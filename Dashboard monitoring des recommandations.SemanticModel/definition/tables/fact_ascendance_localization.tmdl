table fact_ascendance_localization
	lineageTag: 2dcab0fe-8cd1-4a82-b424-6b40ffb0e151

	measure BatchsAvecMesureNegatives_v2 = ```
			
			COUNTROWS (
			    SUMMARIZE (
			        FILTER (
			            fact_ascendance_localization,
			            fact_ascendance_localization[measure_value] < 0
			        ),
			        fact_ascendance_localization[batch_id],
			        fact_ascendance_localization[measure_name]
			    )
			)
			
			```
		formatString: 0
		lineageTag: 2fa62519-f02c-4178-911e-aa96837388fc

	measure NbrMesuresNulle_v2 = ```
			
			SUMX(
			    VALUES(fact_ascendance_localization[batch_id]),
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(
			                FILTER(
			                    fact_ascendance_localization,
			                    ISBLANK(fact_ascendance_localization[measure_value]) &&
			                    fact_ascendance_localization[batch_id] = EARLIER(fact_ascendance_localization[batch_id])
			                ),
			                "measure_name", fact_ascendance_localization[measure_name]
			            )
			        )
			    )
			)
			
			```
		formatString: 0
		lineageTag: e5d9e322-79b5-4dbf-8c15-e0ab45ea92c2

	measure NbrMesuresNulles_V2 = ```
			
			SUMX(
			    VALUES(fact_ascendance_localization[batch_id]),
			    COUNTROWS(
			        DISTINCT(
			            SELECTCOLUMNS(
			                FILTER(
			                    fact_ascendance_localization,
			                    ISBLANK(fact_ascendance_localization[measure_value]) &&
			                    fact_ascendance_localization[batch_id] = EARLIER(fact_ascendance_localization[batch_id])
			                ),
			                "measure_name", fact_ascendance_localization[measure_name]
			            )
			        )
			    )
			)
			
			```
