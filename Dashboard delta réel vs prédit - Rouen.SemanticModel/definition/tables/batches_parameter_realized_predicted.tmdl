	measure 'texte_moy._delta' = ```
			"En moyenne le delta entre les valeurs réelles et les valeurs recommandées sur cette sélection est de " & ROUND(AVERAGE(batches_parameter_realized_predicted[realized_value])-AVERAGE(batches_parameter_realized_predicted[predicted_value]),1)
			
			
			```
		lineageTag: 571c7bfe-0115-4d89-b0ed-7780165ab73e

	measure nb_valeur_réelle = "Nombre de valeur réelle : " & IF(COUNT(batches_parameter_realized_predicted[realized_value]) = 0,0,COUNT(batches_parameter_realized_predicted[realized_value]))
		lineageTag: 8a97af40-78e5-4482-ac6d-e74b66b10d08

	measure nb_valeur_prédite = "Nombre de valeur recommandée : " & IF(COUNT(batches_parameter_realized_predicted[predicted_value]) = 0,0,COUNT(batches_parameter_realized_predicted[predicted_value]))
