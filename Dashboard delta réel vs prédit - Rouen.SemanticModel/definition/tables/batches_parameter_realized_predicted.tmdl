	column 'realized_value (compartiments)' = ```
			VAR __Count = 12
			
			VAR __Min = MIN('batches_parameter_realized_predicted'[realized_value])
			
			VAR __Max = MAX('batches_parameter_realized_predicted'[realized_value])
			
			VAR __Difference = (__Max - __Min)
			
			VAR __Size = IF(__Difference > 0, __Difference / __Count, 1)
			
			VAR __BinNumber = 
				IF(
					ISBLANK('batches_parameter_realized_predicted'[realized_value]),
					BLANK(),
					ROUNDDOWN(('batches_parameter_realized_predicted'[realized_value] - __Min) / __Size, 0)
				)
			
			RETURN
				IF(
					ISBLANK('batches_parameter_realized_predicted'[realized_value]),
					BLANK(),
					__Min + (MIN(__BinNumber, __Count - 1) * __Size)
				)
			```
		lineageTag: 6093af19-9e68-4c86-8825-9022fef6d0ca
		summarizeBy: none

