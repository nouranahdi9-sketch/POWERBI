	column 'Valeur (compartiments)' = ```
			VAR __Count = 12
			
			VAR __Min = MIN('batches_parameter_realized_predicted pivot'[Valeur])
			
			VAR __Max = MAX('batches_parameter_realized_predicted pivot'[Valeur])
			
			VAR __Difference = (__Max - __Min)
			
			VAR __Size = IF(__Difference > 0, __Difference / __Count, 1)
			
			VAR __BinNumber = 
				IF(
					ISBLANK('batches_parameter_realized_predicted pivot'[Valeur]),
					BLANK(),
					ROUNDDOWN(('batches_parameter_realized_predicted pivot'[Valeur] - __Min) / __Size, 0)
				)
			
			RETURN
				IF(
					ISBLANK('batches_parameter_realized_predicted pivot'[Valeur]),
					BLANK(),
					__Min + (MIN(__BinNumber, __Count - 1) * __Size)
				)
			```
