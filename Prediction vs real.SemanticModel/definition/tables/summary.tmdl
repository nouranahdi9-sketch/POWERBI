	column Acceptance_Status_EN = ```
			
			SWITCH(
			    TRUE(),
			    'summary'[acceptance_status] = "Acceptée",       "Accepted",
			    'summary'[acceptance_status] = "En attente",     "Pending",
			    'summary'[acceptance_status] = "Refusée IA",     "AI Rejected",
			    'summary'[acceptance_status] = "Refusée usine",  "Plant Rejected",
			    'summary'[acceptance_status]                    -- garde la valeur originale si aucune correspondance
			)
			
			```
