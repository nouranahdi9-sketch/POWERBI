	measure betaglucan_%_IA_result =
			
			VAR Oui =
			    CALCULATE(
			        COUNTROWS('delta_quality_realized_recommended'),
			        'delta_quality_realized_recommended'[betaglucan_recommended_result] = "OUI"
			    )
			VAR Total =
			COUNTROWS(
			    FILTER(
			        'delta_quality_realized_recommended',
			        'delta_quality_realized_recommended'[betaglucan_recommended_result] <> "null" &&
			        NOT(ISBLANK('delta_quality_realized_recommended'[betaglucan_recommended_result]))
			    )
			)
			RETURN
			    DIVIDE(Oui, Total)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 21408bf1-36c2-4f9b-8479-9a6582b549b1

