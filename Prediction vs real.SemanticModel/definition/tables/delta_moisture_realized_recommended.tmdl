table delta_moisture_realized_recommended
	lineageTag: e852387b-2c1a-4952-b344-4715aa6f3739

	measure steep_c2_moisture_%_IA_result =
			
			VAR Oui =
			    CALCULATE(
			        COUNTROWS('delta_moisture_realized_recommended'),
			        'delta_moisture_realized_recommended'[steep_c2_moisture_recommended_result] = "OUI"
			    )
			VAR Total =
			COUNTROWS(
			    FILTER(
			        'delta_moisture_realized_recommended',
			        'delta_moisture_realized_recommended'[steep_c2_moisture_recommended_result] <> "null" &&
			        NOT(ISBLANK('delta_moisture_realized_recommended'[steep_c2_moisture_recommended_result]))
			    )
			)
			RETURN
			    DIVIDE(Oui, Total)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 15289fae-060c-42af-901f-c411331498bc

	measure pregerm_moisture_%_IA_result =
			
			VAR Oui =
			    CALCULATE(
			        COUNTROWS('delta_moisture_realized_recommended'),
			        'delta_moisture_realized_recommended'[pregerm_moisture_recommended_result] = "OUI"
			    )
			VAR Total =
			COUNTROWS(
			    FILTER(
			        'delta_moisture_realized_recommended',
			        'delta_moisture_realized_recommended'[pregerm_moisture_recommended_result] <> "null" &&
			        NOT(ISBLANK('delta_moisture_realized_recommended'[pregerm_moisture_recommended_result]))
			    )
			)
			RETURN
			    DIVIDE(Oui, Total)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 5f80c18d-cd15-4b65-adff-e8e7a1caa25b

	measure kiln_load_moisture_%_IA_result =
			
			VAR Oui =
			    CALCULATE(
			        COUNTROWS('delta_moisture_realized_recommended'),
			        'delta_moisture_realized_recommended'[kiln_load_moisture_recommended_result] = "OUI"
			    )
			VAR Total =
			COUNTROWS(
			    FILTER(
			        'delta_moisture_realized_recommended',
			        'delta_moisture_realized_recommended'[kiln_load_moisture_recommended_result] <> "null" &&
			        NOT(ISBLANK('delta_moisture_realized_recommended'[kiln_load_moisture_recommended_result]))
			    )
			)
			RETURN
			    DIVIDE(Oui, Total)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 1b69cde1-a29e-4180-b075-ba813c62c7f3

	measure borne_max_steep_c2_moisture = IF(MAX(delta_moisture_realized_recommended[steep_c2_moisture]) > MAX(delta_moisture_realized_recommended[steep_c2_moisture_recommended]), MAX(delta_moisture_realized_recommended[steep_c2_moisture])*1.05, MAX(delta_moisture_realized_recommended[steep_c2_moisture_recommended])*1.05)
		lineageTag: 0af01320-0d91-47d3-aada-23044567c72a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure borne_min_steep_c2_moisture = IF(MIN(delta_moisture_realized_recommended[steep_c2_moisture]) < MIN(delta_moisture_realized_recommended[steep_c2_moisture_recommended]), MIN(delta_moisture_realized_recommended[steep_c2_moisture])*0.95, MIN(delta_moisture_realized_recommended[steep_c2_moisture_recommended])*0.95)
		lineageTag: 6e0475cf-de66-4f53-ad99-694f3509ea0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure borne_min_pregerm_moisture = IF(MIN(delta_moisture_realized_recommended[pregerm_moisture]) < MIN(delta_moisture_realized_recommended[pregerm_moisture_recommended]), MIN(delta_moisture_realized_recommended[pregerm_moisture])*0.95, MIN(delta_moisture_realized_recommended[pregerm_moisture_recommended])*0.95)
		lineageTag: 39defa2f-fa6e-4bff-ae9b-4ee3d1001cd7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure borne_max_pregerm_moisture = IF(MAX(delta_moisture_realized_recommended[pregerm_moisture]) > MAX(delta_moisture_realized_recommended[pregerm_moisture_recommended]), MAX(delta_moisture_realized_recommended[pregerm_moisture])*1.05, MAX(delta_moisture_realized_recommended[pregerm_moisture_recommended])*1.05)
		lineageTag: 6e52a335-9b4e-47a3-bf46-e8bc7e283562

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure borne_max_kiln_load_moisture = IF(MAX(delta_moisture_realized_recommended[kiln_load_moisture]) > MAX(delta_moisture_realized_recommended[kiln_load_moisture_recommended]), MAX(delta_moisture_realized_recommended[kiln_load_moisture])*1.05, MAX(delta_moisture_realized_recommended[kiln_load_moisture_recommended])*1.05)
		lineageTag: 73ab335e-f0cc-4604-9a65-9b602483b759

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure borne_min_kiln_load_moisture = IF(MIN(delta_moisture_realized_recommended[kiln_load_moisture]) < MIN(delta_moisture_realized_recommended[kiln_load_moisture_recommended]), MIN(delta_moisture_realized_recommended[kiln_load_moisture])*0.95, MIN(delta_moisture_realized_recommended[kiln_load_moisture_recommended])*0.95)
		lineageTag: 0ffc4025-177f-4459-9419-1baa0310a547

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'moy. borne_result_moisture' =
			
			IF(
			  AND(
			    ISBLANK([steep_c2_moisture_%_IA_result]),
			    ISBLANK([pregerm_moisture_%_IA_result])
			  ),
			  [kiln_load_moisture_%_IA_result],
			  IF(
			    ISBLANK([steep_c2_moisture_%_IA_result]),
			    ([pregerm_moisture_%_IA_result] + [kiln_load_moisture_%_IA_result]) / 2,
			    IF(
			      ISBLANK([pregerm_moisture_%_IA_result]),
			      ([steep_c2_moisture_%_IA_result] + [kiln_load_moisture_%_IA_result]) / 2,
			      ([steep_c2_moisture_%_IA_result] + [pregerm_moisture_%_IA_result] + [kiln_load_moisture_%_IA_result]) / 3
			    )
			  )
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: a2709edc-1cdd-40f7-acd1-935d2377bd7e

	measure steep_c2_moisture_%_result =
			
			VAR Oui =
			    CALCULATE(
			        COUNTROWS('delta_moisture_realized_recommended'),
			        'delta_moisture_realized_recommended'[steep_c2_moisture_result] = "OUI"
			    )
			VAR Total =
			COUNTROWS(
			    FILTER(
			        'delta_moisture_realized_recommended',
			        'delta_moisture_realized_recommended'[steep_c2_moisture_result] <> "null" &&
			        NOT(ISBLANK('delta_moisture_realized_recommended'[steep_c2_moisture_result]))
			    )
			)
			RETURN
			    DIVIDE(Oui, Total)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
