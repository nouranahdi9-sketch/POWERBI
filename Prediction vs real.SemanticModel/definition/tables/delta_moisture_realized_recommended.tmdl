	column Acceptance_Status2_EN =
			
			SWITCH(
			    TRUE(),
			    'delta_moisture_realized_recommended'[acceptance_status] = "Acceptée",       "Accepted",
			    'delta_moisture_realized_recommended'[acceptance_status] = "En attente",     "Pending",
			    'delta_moisture_realized_recommended'[acceptance_status] = "Refusée IA",     "AI Rejected",
			    'delta_moisture_realized_recommended'[acceptance_status] = "Refusée usine",  "Plant Rejected",
			    'delta_moisture_realized_recommended'[acceptance_status]                    -- garde la valeur originale si aucune correspondance
			)
		lineageTag: 019e2e60-0cac-4bb8-b515-b6f14f6fdbf9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column stage_order = ```
			
			VAR txt = 'delta_moisture_realized_recommended'[target_localization]
			
			// Détection de l'étape (FR & EN)
			VAR stage =
			    SWITCH ( TRUE(),
			        CONTAINSSTRING ( txt, "Trempe" ) || CONTAINSSTRING ( txt, "Steeping" ),       "Steeping",
			        CONTAINSSTRING ( txt, "Pré-germ" ) || CONTAINSSTRING ( txt, "Pre-germ" ),     "PreGerm",
			        CONTAINSSTRING ( txt, "Germination" ) || CONTAINSSTRING ( txt, "Germin" ),    "Germination",
			        CONTAINSSTRING ( txt, "Touraille" ) || CONTAINSSTRING ( txt, "Kilning" ),     "Kilning",
			        BLANK ()
			    )
			
			// Extraction du numéro de jour (FR: "J1", EN: "Day 1")
			VAR posJ   = SEARCH ( "J", txt, 1, 0 )
			VAR dayJ   = IF ( posJ > 0, VALUE ( TRIM ( MID ( txt, posJ + 1, 2 ) ) ), BLANK () )
			
			VAR posDay = SEARCH ( "Day", txt, 1, 0 )
			VAR dayEN  = IF ( posDay > 0, VALUE ( TRIM ( MID ( txt, posDay + 4, 2 ) ) ), BLANK () )
			
			VAR d = COALESCE ( dayJ, dayEN )
			
			RETURN
			    SWITCH ( stage,
			        "Steeping",    SWITCH ( d, 1, 1, 2, 2, BLANK() ),
			        "PreGerm",     3,
			        "Germination", SWITCH ( d, 1, 4, 2, 5, 3, 6, 4, 7, 5, 8, BLANK() ),
			        "Kilning",     SWITCH ( d, 1, 9, 2, 10, BLANK() ),
			        BLANK()
			    )
			
			```
		formatString: 0
		lineageTag: 93b82be0-d0a6-40b3-a80e-afa9029c0706
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

