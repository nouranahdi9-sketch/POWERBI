table Periode
	lineageTag: 9ed1b5be-593f-4748-b081-e5b38d733190

	measure FiltrePeriode =
			
			VAR NowFrance =
			    MAX('dim_batches_specifications'[HeureFranceDynamique])
			
			VAR NbHeures =
			    SELECTEDVALUE(Periode[Heures], 72)
			
			RETURN
			IF(
			    MAX('fact_process_time_analyses'[date_fin])
			        >= NowFrance - (NbHeures / 24)
			    &&
			    MAX('fact_process_time_analyses'[date_fin])
			        <= NowFrance,
			    1,
			    0
			)
		formatString: 0
		lineageTag: f6deadce-3105-4feb-8ac6-62ea12deb245

	measure FiltrePeriodeNotes =
			
			VAR NowFrance =
			    MAX('dim_batches_specifications'[HeureFranceDynamique])
			
			VAR NbHeures =
			    SELECTEDVALUE(Periode[Heures], 72)
			
			RETURN
			IF(
			    MAX('fact_batch_note'[date_saisie])
			        >= NowFrance - (NbHeures / 24)
			    &&
			    MAX('fact_batch_note'[date_saisie])
			        <= NowFrance,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 937b8a00-a7c5-4bd8-bfca-4dcbb95dcba1

	column Label
		lineageTag: 41f72d3f-4abc-4d51-a8e5-b615ab2579ea
		summarizeBy: none
		isNameInferred
		sourceColumn: [Label]

		annotation SummarizationSetBy = Automatic

	column Heures
		formatString: 0
		lineageTag: c46edb9c-f5e3-48db-b95a-40ebb2a7c400
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Heures]

		annotation SummarizationSetBy = Automatic

	partition Periode = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Label", STRING,
				    "Heures", INTEGER,
				    {
				        {"12h", 12},
				        {"24h", 24},
				        {"48h", 48},
				        {"72h", 72}
				    }
				)

	annotation PBI_Id = f059997811714505a82785dc344fbd5f

