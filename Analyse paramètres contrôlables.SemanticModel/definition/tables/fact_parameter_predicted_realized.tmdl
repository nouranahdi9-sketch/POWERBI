table fact_parameter_predicted_realized
	lineageTag: e2a1ef6f-c84e-4460-aaf8-570dd7ddb604

	measure Median_gap_IA_reel = ```
			
			CALCULATE(
			    MEDIANX(
			        VALUES('fact_parameter_predicted_realized'[gap_IA_reel]),
			        'fact_parameter_predicted_realized'[gap_IA_reel]
			    )
			)
			
			
			```
		lineageTag: 96ab792a-fbcf-48b9-9ce7-7ae7da49e85e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure IQR_gap_IA_reel = ```
			
			VAR Q1 = CALCULATE(
			    PERCENTILEX.INC(
			        'fact_parameter_predicted_realized',
			        'fact_parameter_predicted_realized'[gap_IA_reel],
			        0.25
			    )
			)
			VAR Q3 = CALCULATE(
			    PERCENTILEX.INC(
			        'fact_parameter_predicted_realized',
			        'fact_parameter_predicted_realized'[gap_IA_reel],
			        0.75
			    )
			)
			RETURN
			Q3 - Q1
			
			
			
			```
		lineageTag: dbd47eeb-8f49-45c2-affc-d6eb9d613736

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MinValeur = ```
			MINX(ALLSELECTED('fact_parameter_predicted_realized'), MIN('fact_parameter_predicted_realized'[recommended_value], 'fact_parameter_predicted_realized'[realized_value]))
			
			```
		lineageTag: bd894d7c-5a09-4c73-9312-7802eeeca04d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MaxValeur = ```
			MAXX(ALLSELECTED('fact_parameter_predicted_realized'), MAX('fact_parameter_predicted_realized'[recommended_value], 'fact_parameter_predicted_realized'[realized_value]))
			
			```
		lineageTag: d16b4176-23c6-4bdc-8727-17433713ef9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

