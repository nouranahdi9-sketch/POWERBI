	column 'Week Number'
		formatString: 0
		lineageTag: 2ded7e0c-3345-41d5-a432-c82fed363df2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Week Number]

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source =
				
				VAR MIN_DATE = "01/01/2024"
				VAR MAX_DATE = TODAY()
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MIN_DATE, MAX_DATE),
				    "Year", YEAR([Date]),
				    "Month", MONTH([Date]),
				    "Day", DAY([Date]),
				    "Week Number", WEEKNUM([Date], 2)
				)

	annotation PBI_Id = 2b617de29bf845de8b406b67c21d9df2

