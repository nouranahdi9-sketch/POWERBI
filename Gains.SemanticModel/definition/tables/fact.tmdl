table fact
	lineageTag: eacac078-17ec-4d34-b0a0-04cf178b8677

	measure Ecart_R2sec =
			
			AVERAGE('fact'[reel_r2_sec]) - AVERAGE('fact'[baseline_r2_sec])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 28c22402-3e51-428e-87b2-0c3147d02ffe

	measure 'Sous_total Malt_Sec' =
			
			SUM('fact'[baseline_malt_sec]) + SUM('fact'[malt_sec_supplementaire_via_perf_r2_sec])
		lineageTag: 9578463f-b846-46ea-b1f7-bc8d05a78f6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ecart_orge_sec =
			
			SUM('fact'[reel_orge_sec]) - SUM('fact'[baseline_orge_sec])
		lineageTag: fddf1683-0ba5-495f-9043-7f0f87954a24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sous_total Malt_sec_taille_batch' =
			
			SUM('fact'[malt_sec_supplementaire_via_taille_batch_equivalent_baseline]) + SUM('fact'[malt_sec_supplementaire_via_taille_batch_et_perf_r2_sec])
		lineageTag: cc2699d4-bca2-465b-9b83-f0c7c16b7973

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Malt sec' =
			
			[Sous_total Malt_Sec] + [Sous_total Malt_sec_taille_batch]
		lineageTag: bd8cf133-d49f-47af-a002-29fd7f61032f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Surplus Malt Sec / Baseline' =
			
			SUM('fact'[malt_sec_supplementaire_via_perf_r2_sec]) + SUM('fact'[malt_sec_supplementaire_via_taille_batch_et_perf_r2_sec])
		lineageTag: 22555de7-44cc-4734-8b52-e73d8a266cbe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '0 reco' =
			
			VAR DateActuelle = MAX('fact'[date_fin_production])
			
			RETURN
			CALCULATE(
			    SUM('fact'[total_malt_humide_supplementaire]),
			    FILTER(
			        ALLSELECTED('fact'),
			        'fact'[date_fin_production] <= DateActuelle
			            && 'fact'[reco_acceptee] = 0
			    )
			)
		displayFolder: gain reco.
		lineageTag: 174cc9f7-6bf9-4137-a76e-063f1071e9b9

