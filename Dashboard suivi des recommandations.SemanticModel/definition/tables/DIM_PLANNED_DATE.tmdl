	column FirstDateByWeek =
			
			CALCULATE(
			    MIN('DIM_PLANNED_DATE'[Date]),
			    ALLEXCEPT('DIM_PLANNED_DATE', 'DIM_PLANNED_DATE'[Week Number], 'DIM_PLANNED_DATE'[Year])
			)
		formatString: Short Date
		lineageTag: 4a67b4f8-f30d-4a7a-974b-e130ee028373
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 8280022f-8790-432d-848c-bdd1bb273e97
			defaultHierarchy: LocalDateTable_f4213160-42c1-48ed-a182-dbcd4156c523.'Hiérarchie de dates'

		annotation SummarizationSetBy = Automatic

	partition DIM_PLANNED_DATE = calculated
		mode: import
		source =
				
				VAR MIN_DATE = "01/01/2024"
				VAR MAX_DATE = TODAY()
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MIN_DATE, MAX_DATE),
				    "Year", YEAR([Date]),
				    "Month", MONTH([Date]),
				    "Day", DAY([Date]),
				    "Week Number", WEEKNUM([Date], 2)
				)

	annotation PBI_Id = 885f8113281541a39b2298223b9a0a7e

