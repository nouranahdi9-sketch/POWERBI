table features_front_too_high_low
	lineageTag: d5e38962-3f81-4bb5-b241-d26210ae386d

	measure DistinctCount_TooHigh =
			
			CALCULATE(
			    COUNT('features_front_too_high_low'[values]),
			    'features_front_too_high_low'[rate] = "too_high"
			)
		formatString: 0
		lineageTag: 56bc4b68-f227-4a60-9112-1ac54ef51cf5

	measure DistinctCount_TooLow =
			
			CALCULATE(
			    COUNT('features_front_too_high_low'[id_recommendation]),
			    'features_front_too_high_low'[rate] = "too_low"
			)
		formatString: 0
		lineageTag: 7e63f459-1a4f-47d7-bc73-9a369d680d11

	measure Percent_TooHigh =
			
			DIVIDE(
			    CALCULATE(COUNT('features_front_too_high_low'[values]), 'features_front_too_high_low'[rate] = "too_high"),
			    CALCULATE(COUNT('features_front_too_high_low'[values]), 'features_front_too_high_low'[rate] = "too_high") + CALCULATE(COUNT('features_front_too_high_low'[values]), 'features_front_too_high_low'[rate] = "too_low"),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 528abde9-9818-43d6-9ab4-ad6ef82d6868

	measure Percent_TooLow =
			
			DIVIDE(
			    CALCULATE(COUNT('features_front_too_high_low'[values]), 'features_front_too_high_low'[rate] = "too_low"),
			    CALCULATE(COUNT('features_front_too_high_low'[values]), 'features_front_too_high_low'[rate] = "too_low") + CALCULATE(COUNT('features_front_too_high_low'[values]), 'features_front_too_high_low'[rate] = "too_high"),
			    0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
