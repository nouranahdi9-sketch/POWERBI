table fact_parameter_tolerance
	lineageTag: 2a73bc9d-1c61-4bf3-9bfd-d03541661888

	measure Seuil_bas = ```
			
			VAR TypeParam = SELECTEDVALUE(dim_parameter_variable[type])
			RETURN
			SWITCH(
			    TypeParam,
			    "Temperature", (1 - ([Valeur Temperature] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    "Duration", (1 - ([Valeur Duration] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    "Count", (1 - ([Valeur Count] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    "Speed", (1 - ([Valeur Speed] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    BLANK()
			)
			
			```
		lineageTag: 543034d0-f883-439b-8f94-af49bc853d26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Seuil_haut =
			
			VAR TypeParam = SELECTEDVALUE(dim_parameter_variable[type])
			RETURN
			SWITCH(
			    TypeParam,
			    "Temperature", (1 + ([Valeur Temperature] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    "Duration", (1 + ([Valeur Duration] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    "Count", (1 + ([Valeur Count] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    "Speed", (1 + ([Valeur Speed] / 100)) * SUM(fact_parameter_tolerance[recommended_value]),
			    BLANK()
			)
		lineageTag: 8b475f61-91f1-42fc-9464-dad81d3607f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Status tolerance V2' =
			
			VAR realizedValue = SUM(fact_parameter_tolerance[realized_value])
			RETURN IF(ISBLANK(realizedValue), BLANK(), IF(AND([Seuil_haut] >= realizedValue, [Seuil_bas] <= realizedValue), "Appliquée", "Non appliquée"))
		lineageTag: 8428a0b4-cd54-4bea-81d8-48f6f53d8384

	measure Status_Tolerance_Final = ```
			
			VAR NbTotal =
			    CALCULATE(
			        DISTINCTCOUNT(dim_parameter_variable[parameter_variable_label]),
			        ALLEXCEPT(fact_parameter_tolerance, fact_parameter_tolerance[id_recommendation])
			    )
			
			VAR NbApplique =
			    CALCULATE(
			        SUMX(
			            VALUES(dim_parameter_variable[parameter_variable_label]),
			            IF([Status tolerance V2] = "Appliquée", 1, 0)
			        ),
			        ALLEXCEPT(fact_parameter_tolerance, fact_parameter_tolerance[id_recommendation])
			    )
			
			RETURN
			IF(NbTotal = NbApplique, "Appliquée", "Non appliquée")
			
			```
		lineageTag: ecabcce3-2014-4359-bf92-239642138719

	measure Pourcentage_Applique = ```
			
			VAR NbIdTotal =
			    DISTINCTCOUNT(fact_parameter_tolerance[id_recommendation])
			
			VAR NbIdApplique =
			    CALCULATE(
			        DISTINCTCOUNT(fact_parameter_tolerance[id_recommendation]),
			        FILTER(
			            VALUES(fact_parameter_tolerance[id_recommendation]),
			            CALCULATE(
			                DISTINCTCOUNT(dim_parameter_variable[parameter_variable_label])
			            ) =
			            CALCULATE(
			                SUMX(
			                    VALUES(dim_parameter_variable[parameter_variable_label]),
			                    IF([Status tolerance V2] = "Appliquée", 1, 0)
			                )
			            )
			        )
			    )
			
			RETURN
			DIVIDE(NbIdApplique, NbIdTotal, 0)
			
			```
		lineageTag: 6ef9319a-8e18-4a43-bd6f-c7ff497dc2a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pourcentage_non_applique = 1-[Pourcentage_Applique]
		lineageTag: e60d9f0b-b091-4f1b-960d-6e8b12a01a92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Appliquée' = ```
			
			VAR TotalLignes = COUNTROWS('fact_parameter_tolerance')
			VAR TotalAppliquee = 
			    CALCULATE(
			        COUNTROWS('fact_parameter_tolerance'),
			        'fact_parameter_tolerance'[applied_status] = "Appliquée"
			    )
			RETURN
			DIVIDE(TotalAppliquee, TotalLignes, 0)
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 8821be08-fcb4-4b29-a19b-c97659ca70f9

