	column Status_Keep_Discard = ```
			
			IF(
			    ISBLANK(fact_parameter_tolerance[realized_value]) || 
			    TRIM(fact_parameter_tolerance[realized_value] & "") = "" || 
			    ISBLANK(fact_parameter_tolerance[recommended_value]) || 
			    TRIM(fact_parameter_tolerance[recommended_value] & "") = "", 
			    "Vide", 
			    "A garder"
			)
			
			```
