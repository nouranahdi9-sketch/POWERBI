table batches_reco
	lineageTag: 9327bf63-cc6e-4300-8ac8-4f2bc66938d4

	measure %reco_évaluées = SUM(batches_reco[evaluee]) / SUM(batches_reco[total_all])
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 11b2d0af-a4f1-4ef0-a6a4-1e1f271a0ec7

	measure %reco_acceptées = ```
			SUM(batches_reco[acceptee]) / SUM(batches_reco[Total_all]) 
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 52dc008c-c2a6-45a3-9bcb-86150c274784

	measure %reco_acceptées_appliquées = ```
			SUM(batches_reco[acceptee_et_appliquee]) / SUM(batches_reco[total_all]) 
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 363c4282-96a2-484e-a9b2-fa1eec2b0143

	measure %reco_évaluées_appliquées = ```
			SUM(batches_reco[acceptee_et_appliquee]) / SUM(batches_reco[evaluee]) 
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 509e3c15-2d68-4304-b3b5-6e8ffea179c8

	measure %reco_reçues = SUM(batches_reco[total]) / SUM(batches_reco[nb_reco_opti])
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: b8666657-00ab-4e86-85fa-24d2ea3b16b7

	measure batch_sans_reco = IF(COUNTROWS(FILTER(batches_reco, batches_reco[total] = 0)) = 0, 0, COUNTROWS(FILTER(batches_reco, batches_reco[total] = 0)))
		formatString: 0
		lineageTag: a58807bd-bd43-48d2-a01f-02000c6e801c

	measure nb_reco_reçues = SUM(batches_reco[total]) & " recommandations"
		lineageTag: e8b3fbbf-b665-4568-b9e0-6784e8065418

	measure %reco_disponibles = SUM(batches_reco[total]) / SUM(batches_reco[nb_reco_opti])
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 6c9ae7d5-3ed5-4fe6-8e7b-d444932f9aea

	measure %reco_refusée = ```
			SUM(batches_reco[refusee]) / SUM(batches_reco[Total_all]) 
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: ceee78f9-ce98-47b5-b390-066555b9d07a

