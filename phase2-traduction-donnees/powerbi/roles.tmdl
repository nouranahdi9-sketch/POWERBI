role Translation
	modelPermission: read

	tablePermission dim_trad_language =
			VAR __culture =
			    LOWER ( LEFT ( USERCULTURE (), 2 ) )
			VAR __supported =
			    NOT ISEMPTY (
			        FILTER (
			            ALL ( dim_trad_language ),
			            dim_trad_language[culture_code] = __culture
			        )
			    )
			RETURN
			    dim_trad_language[culture_code] = IF ( __supported, __culture, "en" )
