	column DIFFHEURE = dim_batches_specifications[HEUREUTC]-dim_batches_specifications[HEURE]
		formatString: General Date
		lineageTag: d4628f79-08a4-4e85-8503-08b8094edca3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HeureFranceDynamique =
			
			VAR UtcNowValue = UTCNOW()
			VAR Annee = YEAR(UtcNowValue)
			
			VAR DernierDimancheMars =
			    DATE(Annee, 3, 31)
			    - MOD(WEEKDAY(DATE(Annee, 3, 31), 2), 7)
			
			VAR DernierDimancheOctobre =
			    DATE(Annee, 10, 31)
			    - MOD(WEEKDAY(DATE(Annee, 10, 31), 2), 7)
			
			VAR DebutHeureEte =
			    DernierDimancheMars + TIME(1, 0, 0)
			
			VAR FinHeureEte =
			    DernierDimancheOctobre + TIME(1, 0, 0)
			
			VAR EstHeureEte =
			    UtcNowValue >= DebutHeureEte
			        && UtcNowValue < FinHeureEte
			
			RETURN
			    UtcNowValue + IF(EstHeureEte, TIME(2, 0, 0), TIME(1, 0, 0))
		formatString: General Date
		lineageTag: 6b84d7f3-d1ff-443c-8a8c-18309d4a3782
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

