	/// Multi-impact : tous les libellés traduits des impacts de la note,
	/// triés par category_order puis libellé, séparés par ", ".
	/// Vide si la note n'a aucun des impacts filtrés (filtre Impact, filtre de visuel) :
	/// la ligne de la note disparaît alors des tableaux. Sinon, la liste complète
	/// des impacts de la note est affichée, sans tenir compte de ces filtres.
	measure Impact =
			
			VAR _keys =
			    CALCULATETABLE (
			        VALUES ( fact_batch_note_impact[key_impact] ),
			        REMOVEFILTERS ( fact_batch_note_impact[key_impact] ),
			        REMOVEFILTERS ( dim_batch_note_impact ),
			        REMOVEFILTERS ( dim_trad_batch_note_impact )
			    )
			VAR _labels =
			    CALCULATETABLE (
			        SUMMARIZE (
			            dim_trad_batch_note_impact,
			            dim_trad_batch_note_impact[label],
			            dim_batch_note_impact[category_order]
			        ),
			        REMOVEFILTERS ( dim_batch_note_impact ),
			        REMOVEFILTERS ( dim_trad_batch_note_impact ),
			        TREATAS ( _keys, dim_batch_note_impact[id_batch_note_category] )
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( fact_batch_note_impact ) && NOT ISEMPTY ( _labels ),
			        CONCATENATEX (
			            _labels,
			            dim_trad_batch_note_impact[label],
			            ", ",
			            dim_batch_note_impact[category_order], ASC,
			            dim_trad_batch_note_impact[label], ASC
			        )
			    )
		lineageTag: 69272839-9766-402b-835a-2e1689d50bef

