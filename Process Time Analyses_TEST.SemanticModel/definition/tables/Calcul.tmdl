	/// Courbe 12 semaines de Synthèse macro : moyenne de la semaine de l'axe (table Semaines),
	/// pour les 12 semaines qui finissent par la dernière semaine sélectionnée (Année / Mois / Semaine),
	/// ou par la dernière semaine de données si rien n'est sélectionné.
	measure 'Durée moyenne du cycle (h)' =
			
			VAR _semaine_fin = CALCULATE ( MAX ( fact_process_time_analyses[Debut_semaine_fin] ) )
			VAR _semaine = SELECTEDVALUE ( Semaines[Début semaine] )
			RETURN
			    IF (
			        NOT ISBLANK ( _semaine ) && _semaine <= _semaine_fin && _semaine > _semaine_fin - 84,
			        CALCULATE (
			            AVERAGE ( fact_process_time_analyses[mesure_value_h] ),
			            REMOVEFILTERS ( fact_process_time_analyses[year_mesure], fact_process_time_analyses[week_mesure],
			                fact_process_time_analyses[month_name_mesure], fact_process_time_analyses[month_num_mesure] ),
			            REMOVEFILTERS ( dim_month ),
			            REMOVEFILTERS ( dim_trad_month ),
			            TREATAS ( { _semaine }, fact_process_time_analyses[Debut_semaine_fin] )
			        )
			    )
		formatString: 0.00
		displayFolder: Mesures\Synthese
		lineageTag: 2c1ad8da-bfe4-451f-a2c0-d25c64de7c64

	measure 'Objectif métier 12 semaines (h)' =
			
			VAR _semaine_fin = CALCULATE ( MAX ( fact_process_time_analyses[Debut_semaine_fin] ) )
			VAR _semaine = SELECTEDVALUE ( Semaines[Début semaine] )
			RETURN
			    IF (
			        NOT ISBLANK ( _semaine ) && _semaine <= _semaine_fin && _semaine > _semaine_fin - 84,
			        CALCULATE (
			            AVERAGE ( fact_process_time_analyses[target_business_h] ),
			            REMOVEFILTERS ( fact_process_time_analyses[year_mesure], fact_process_time_analyses[week_mesure],
			                fact_process_time_analyses[month_name_mesure], fact_process_time_analyses[month_num_mesure] ),
			            REMOVEFILTERS ( dim_month ),
			            REMOVEFILTERS ( dim_trad_month ),
			            TREATAS ( { _semaine }, fact_process_time_analyses[Debut_semaine_fin] )
			        )
			    )
		formatString: 0.00
		displayFolder: Mesures\Synthese
		lineageTag: 696daddd-a219-4010-a139-89a6d7bbecbb

	/// Histogramme de Synthèse macro : temps perdu des 10 premiers éléments du niveau choisi
	/// (boutons Localisation / Impact / Événement / Détail du paramètre de champ Niveau notes).
	measure 'Temps perdu (h) - Top 10' =
			
			VAR _niveau = SELECTEDVALUE ( 'Niveau notes'[Niveau notes Ordre] )
			VAR _valeur = SUM ( fact_batch_note[Gap_Heures] )
			VAR _rang =
			    SWITCH (
			        _niveau,
			        0, RANKX ( ALLSELECTED ( dim_trad_batch_note_location[label] ), CALCULATE ( SUM ( fact_batch_note[Gap_Heures] ) ), , DESC ),
			        1, RANKX ( ALLSELECTED ( dim_trad_batch_note_impact[label] ), CALCULATE ( SUM ( fact_batch_note[Gap_Heures] ) ), , DESC ),
			        2, RANKX ( ALLSELECTED ( dim_trad_batch_note_event[label] ), CALCULATE ( SUM ( fact_batch_note[Gap_Heures] ) ), , DESC ),
			        3, RANKX ( ALLSELECTED ( dim_trad_batch_note_detail[label] ), CALCULATE ( SUM ( fact_batch_note[Gap_Heures] ) ), , DESC )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _valeur ) && _rang <= 10, _valeur )
		formatString: #,0
		displayFolder: Mesures\Synthese
		lineageTag: ac8ab4a3-95ce-4966-b8dc-592a341bafcb

	/// Graphes de Synthèse : durée du batch quand il a au moins une note avec du temps perdu
	/// (points orange, comme les batches en orange de la maquette).
	measure 'Batch avec note de temps perdu' =
			
			VAR _duree = [Synthese_Duree_h]
			VAR _notes = CALCULATE ( COUNTROWS ( fact_batch_note ), fact_batch_note[gap_minutes] > 0 )
			RETURN
			    IF ( NOT ISBLANK ( _duree ) && _notes > 0, _duree )
		formatString: 0.00
		displayFolder: Mesures\Synthese
		lineageTag: 66ca46b0-a20d-4a18-82e3-8623914f6a70

	measure Synthese_Duree_h =
			
			IF (
			    HASONEVALUE ( dim_trs_measure[key] ),
			    AVERAGE ( fact_process_time_analyses[mesure_value_h] )
			)
		formatString: 0.00
		displayFolder: Mesures\Synthese
		lineageTag: 7da5254a-a1dd-4a72-a561-62f1b32aecce

	measure Synthese_Objectif_metier_h =
			
			IF (
			    HASONEVALUE ( dim_trs_measure[key] ),
			    AVERAGE ( fact_process_time_analyses[target_business_h] )
			)
		formatString: 0.00
		displayFolder: Mesures\Synthese
		lineageTag: da83a5f2-67dd-41aa-820f-de0fb0546b2a

	measure Synthese_Temps_perdu_hhmm =
			
			VAR TotalMinutes = ROUND ( SUM ( fact_batch_note[gap_minutes] ), 0 )
			VAR Hours = QUOTIENT ( TotalMinutes, 60 )
			VAR Minutes = TotalMinutes - Hours * 60
			RETURN
			IF ( ISBLANK ( TotalMinutes ), BLANK (), Hours & "h" & FORMAT ( Minutes, "00" ) )
		displayFolder: Mesures\Synthese
		lineageTag: 7c2d7438-5785-42c2-9dc7-bf3aba3a51eb

	measure Synthese_Nb_notes_temps_perdu =
			
			CALCULATE ( COUNTROWS ( fact_batch_note ), fact_batch_note[gap_minutes] > 0 )
		formatString: 0
		displayFolder: Mesures\Synthese
		lineageTag: 3c4bda5c-74e6-4de9-8d24-8b08d6471ac2

