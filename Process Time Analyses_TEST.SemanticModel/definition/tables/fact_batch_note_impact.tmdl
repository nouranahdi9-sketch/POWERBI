/// Table de liaison note <-> impact (multi-impact).
/// Une ligne par couple (id_batch_note, key_impact), obtenue en découpant
/// fact_batch_note[impacts] sur la virgule. Si impacts est vide, on reprend
/// l'ancien key_impact pour ne pas perdre l'historique.
table fact_batch_note_impact
	isHidden
	lineageTag: ac745121-01f4-4548-8fc7-3ca3c25e1caa

	column id_batch_note
		dataType: string
		isHidden
		lineageTag: 066554c3-0898-4fe8-880b-53e4c84b25a0
		summarizeBy: none
		sourceColumn: id_batch_note

		annotation SummarizationSetBy = Automatic

	column key_impact
		dataType: string
		isHidden
		lineageTag: 34feb713-bc5c-4dae-b256-615f6c5720f7
		summarizeBy: none
		sourceColumn: key_impact

		annotation SummarizationSetBy = Automatic

	partition fact_batch_note_impact = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs("adb-5761093891575298.18.azuredatabricks.net", "sql/protocolv1/o/5761093891575298/0612-144800-uikjvj67", [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]),
				    mal_maite_bi_preprd_Database = Source{[Name="mal_maite_bi_preprd",Kind="Database"]}[Data],
				    process_time_analyses_Schema = mal_maite_bi_preprd_Database{[Name="process_time_analyses",Kind="Schema"]}[Data],
				    fact_batch_note_Table = process_time_analyses_Schema{[Name="fact_batch_note",Kind="Table"]}[Data],
				    Colonnes = Table.SelectColumns(fact_batch_note_Table, {"id_batch_note", "impacts", "key_impact"}),
				    ListeImpacts = Table.AddColumn(
				        Colonnes,
				        "liste_impacts",
				        each
				            let
				                multi = if [impacts] = null then "" else Text.Trim(Text.From([impacts])),
				                brut = if multi = "" then [key_impact] else multi,
				                elements = if brut = null then {} else List.Transform(Text.Split(Text.From(brut), ","), Text.Trim),
				                nonVides = List.Select(elements, each _ <> "")
				            in
				                List.Distinct(nonVides),
				        type list
				    ),
				    Selection = Table.SelectColumns(ListeImpacts, {"id_batch_note", "liste_impacts"}),
				    UneLigneParImpact = Table.ExpandListColumn(Selection, "liste_impacts"),
				    SansVides = Table.SelectRows(UneLigneParImpact, each [liste_impacts] <> null and [id_batch_note] <> null),
				    Renomme = Table.RenameColumns(SansVides, {{"liste_impacts", "key_impact"}}),
				    Types = Table.TransformColumnTypes(Renomme, {{"id_batch_note", type text}, {"key_impact", type text}}),
				    Dedoublonne = Table.Distinct(Types)
				in
				    Dedoublonne

	annotation PBI_ResultType = Table

