/// Table de liaison note <-> impact (multi-impact).
/// Une ligne par couple (id_batch_note, key_impact), obtenue en découpant
/// fact_batch_note[key_impacts] (clés impact_xxx séparées par des virgules).
table fact_batch_note_impact
	isHidden
	lineageTag: 81878337-b480-4622-b098-621a3052fc43

	column id_batch_note
		dataType: string
		isHidden
		lineageTag: f2c392d9-503d-40ec-bf2e-47d6d5f932de
		summarizeBy: none
		sourceColumn: id_batch_note

		annotation SummarizationSetBy = Automatic

	column key_impact
		dataType: string
		isHidden
		lineageTag: 4c876ada-c20e-4501-a346-9ed1d157c29f
		summarizeBy: none
		sourceColumn: key_impact

		annotation SummarizationSetBy = Automatic

	partition fact_batch_note_impact = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs("adb-5761093891575298.18.azuredatabricks.net", "sql/protocolv1/o/5761093891575298/0612-144800-uikjvj67", [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]),
				    mal_maite_bi_preprd_Database = Source{[Name="mal_maite_bi_preprd",Kind="Database"]}[Data],
				    process_time_analyses_Schema = mal_maite_bi_preprd_Database{[Name="process_time_analyses",Kind="Schema"]}[Data],
				    fact_batch_note_Table = process_time_analyses_Schema{[Name="fact_batch_note",Kind="Table"]}[Data],
				    Colonnes = Table.SelectColumns(fact_batch_note_Table, {"id_batch_note", "key_impacts"}),
				    AvecImpacts = Table.SelectRows(Colonnes, each [id_batch_note] <> null and [key_impacts] <> null and Text.Trim([key_impacts]) <> ""),
				    ListeImpacts = Table.AddColumn(AvecImpacts, "key_impact", each List.Select(List.Transform(Text.Split([key_impacts], ","), Text.Trim), each _ <> ""), type list),
				    UneLigneParImpact = Table.ExpandListColumn(Table.RemoveColumns(ListeImpacts, {"key_impacts"}), "key_impact"),
				    Types = Table.TransformColumnTypes(UneLigneParImpact, {{"id_batch_note", type text}, {"key_impact", type text}}),
				    Dedoublonne = Table.Distinct(Types)
				in
				    Dedoublonne

	annotation PBI_ResultType = Table

