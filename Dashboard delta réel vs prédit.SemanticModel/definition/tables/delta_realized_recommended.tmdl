	column realized_value
		dataType: double
		lineageTag: cbfc1ef9-04bc-47c0-bd14-f1c5e32583ba
		summarizeBy: sum
		sourceColumn: realized_value

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"delta_realized_recommended","TableItemName":"realized_value (compartiments)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column id_parameter_variable
		dataType: int64
		formatString: 0
		lineageTag: 34c2398e-81dc-4b7a-8096-44dbbdc13d1b
		summarizeBy: sum
		sourceColumn: id_parameter_variable

		annotation SummarizationSetBy = Automatic

	column 'realized_value (compartiments)' = ```
			VAR __Count = 12
			
			VAR __Min = MIN('delta_realized_recommended'[realized_value])
			
			VAR __Max = MAX('delta_realized_recommended'[realized_value])
			
			VAR __Difference = (__Max - __Min)
			
			VAR __Size = IF(__Difference > 0, __Difference / __Count, 1)
			
			VAR __BinNumber = 
				IF(
					ISBLANK('delta_realized_recommended'[realized_value]),
					BLANK(),
					ROUNDDOWN(('delta_realized_recommended'[realized_value] - __Min) / __Size, 0)
				)
			
			RETURN
				IF(
					ISBLANK('delta_realized_recommended'[realized_value]),
					BLANK(),
					__Min + (MIN(__BinNumber, __Count - 1) * __Size)
				)
			```
		lineageTag: 6093af19-9e68-4c86-8825-9022fef6d0ca
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "delta_realized_recommended"
				          }
				        },
				        "Property": "realized_value"
				      }
				    }
				  ]
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"b","Entity":"delta_realized_recommended"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"b"}},"Property":"realized_value"}}],"BinItem":{"Expression":{"Member":{"Expression":{"Discretize":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"b"}},"Property":"realized_value"}},"Count":12}},"Member":"Min"}}}}

