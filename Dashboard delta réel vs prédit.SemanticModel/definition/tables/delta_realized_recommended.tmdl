table delta_realized_recommended
	lineageTag: 4f3cf615-d25c-40ff-b9be-61152961fc64

	measure 'texte_moy._delta' = "En moyenne le delta entre les valeurs réelles et les valeurs recommandées sur cette sélection est de " & ROUND(AVERAGE(delta_realized_recommended[realized_value])-AVERAGE(delta_realized_recommended[recommended_value]),1)
		lineageTag: 571c7bfe-0115-4d89-b0ed-7780165ab73e

	measure nb_valeur_réelle = "Nombre de valeur réelle : " & IF(COUNT(delta_realized_recommended[realized_value]) = 0,0,COUNT(delta_realized_recommended[realized_value]))
		lineageTag: 8a97af40-78e5-4482-ac6d-e74b66b10d08

	measure nb_valeur_prédite = "Nombre de valeur recommandée : " & IF(COUNT(delta_realized_recommended[recommended_value]) = 0,0,COUNT(delta_realized_recommended[recommended_value]))
		lineageTag: b5902fb0-27d3-4805-9dca-ed0602b5f97a

